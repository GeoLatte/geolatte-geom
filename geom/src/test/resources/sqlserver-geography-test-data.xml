        <db_representation></db_representation>
    </TestCase>
    <TestCase>
        <id>12</id>
        <ewkt>POINT EMPTY</ewkt>
        <srid>4326</srid>
        <db_representation>E61000000104000000000000000001000000FFFFFFFFFFFFFFFF01</db_representation>
    </TestCase>
    <TestCase>
        <id>13</id>
        <ewkt>GEOMETRYCOLLECTION EMPTY</ewkt>
        <srid>4326</srid>
        <db_representation>E61000000104000000000000000001000000FFFFFFFFFFFFFFFF07</db_representation>
    </TestCase>
    <TestCase>
        <id>14</id>
        <ewkt>POINT(4.35 50.85)</ewkt>
        <srid>4258</srid>
