<!-- Test data for the Sql Server GEOGRAPHY codec (GeographyDecoders and GeographyEncoders). The
<db_representation> elements are the serialization SQL Server produces for these GEOGRAPHY values; they
were generated with sqlserver-geography-test-data.sql.

The structure is:
<TestCase>:
    <id> [Test case identifier] </id>
    <ewkt> [Specification of the test geometry in Postgis EWKT (1.5), with (longitude latitude) coordinates] </ewkt>
    <srid> [EPSG ID of the CRS] </srid>
    <db_representation> [Hex-string representation of the serialized GEOGRAPHY value] </db_representation>
</TestCase>
-->

<TestCases>
    <TestCase>
        <id>1</id>
        <ewkt>POINT(4.35 50.85)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010CCDCCCCCCCC6C49406666666666661140</db_representation>
    </TestCase>
    <TestCase>
        <id>2</id>
        <ewkt>POINT(4.35 50.85 100)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010DCDCCCCCCCC6C494066666666666611400000000000005940</db_representation>
    </TestCase>
    <TestCase>
        <id>3</id>
        <ewkt>POINTM(4.35 50.85 7)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010ECDCCCCCCCC6C494066666666666611400000000000001C40</db_representation>
    </TestCase>
    <TestCase>
        <id>4</id>
        <ewkt>LINESTRING(4.35 50.85, 5.57 50.63)</ewkt>
        <srid>4326</srid>
        <db_representation>E61000000114CDCCCCCCCC6C49406666666666661140713D0AD7A350494048E17A14AE471640</db_representation>
    </TestCase>
    <TestCase>
        <id>5</id>
        <ewkt>LINESTRING(4.35 50.85, 5.57 50.63, 3.72 51.05)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010403000000CDCCCCCCCC6C49406666666666661140713D0AD7A350494048E17A14AE4716406666666666864940C3F5285C8FC20D4001000000010000000001000000FFFFFFFF0000000002</db_representation>
    </TestCase>
    <TestCase>
        <id>6</id>
        <ewkt>LINESTRING(4.35 50.85 10 1, 5.57 50.63 20 2, 3.72 51.05 30 3)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010703000000CDCCCCCCCC6C49406666666666661140713D0AD7A350494048E17A14AE4716406666666666864940C3F5285C8FC20D40000000000000244000000000000034400000000000003E40000000000000F03F0000000000000040000000000000084001000000010000000001000000FFFFFFFF0000000002</db_representation>
    </TestCase>
    <TestCase>
        <id>7</id>
        <ewkt>POLYGON((4 50, 6 50, 6 52, 4 52, 4 50), (4.5 50.5, 4.5 51, 5 51, 5 50.5, 4.5 50.5))</ewkt>
        <srid>4326</srid>
        <db_representation></db_representation>
    </TestCase>
    <TestCase>
        <id>8</id>
        <ewkt>MULTIPOINT(4.35 50.85, 5.57 50.63)</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010402000000CDCCCCCCCC6C49406666666666661140713D0AD7A350494048E17A14AE471640020000000100000000010100000003000000FFFFFFFF0000000004000000000000000001000000000100000001</db_representation>
    </TestCase>
    <TestCase>
        <id>9</id>
        <ewkt>MULTILINESTRING((4.35 50.85, 5.57 50.63), (3.72 51.05, 4.4 51.22))</ewkt>
        <srid>4326</srid>
        <db_representation>E6100000010404000000CDCCCCCCCC6C49406666666666661140713D0AD7A350494048E17A14AE4716406666666666864940C3F5285C8FC20D405C8FC2F5289C49409A99999999991140020000000100000000010200000003000000FFFFFFFF0000000005000000000000000002000000000100000002</db_representation>
    </TestCase>
    <TestCase>
        <id>10</id>
        <ewkt>MULTIPOLYGON(((4 50, 5 50, 5 51, 4 51, 4 50)), ((6 50, 7 50, 7 51, 6 51, 6 50)))</ewkt>
        <srid>4326</srid>
        <db_representation></db_representation>
    </TestCase>
    <TestCase>
        <id>11</id>
        <ewkt>GEOMETRYCOLLECTION(POINT(4 0), LINESTRING(4 2, 5 3), POLYGON((0 0, 3 0, 3 3, 0 3, 0 0), (1 1, 1 2, 2 2, 2 1, 1 1)))</ewkt>
